{
  "manifest_version": 3,
  "name": "AI_explan",
  "version": "1.0.0",
  "description": "AI驱动的术语解释浏览器扩展，支持多轮对话",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI_explan"
  }
}